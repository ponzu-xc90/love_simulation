\
let currentScene = 1;\
let chatArea, choicesArea;\
let isProcessing = false;\
\
function showScreen(id) \{\
  document.querySelectorAll('#app > div').forEach(d => d.style.display = 'none');\
  document.getElementById(id).style.display = 'flex';\
\}\
\
function startGame() \{\
  chatArea = document.getElementById('chat-area');\
  choicesArea = document.getElementById('choices-area');\
  chatArea.innerHTML = '';\
  choicesArea.innerHTML = '';\
  currentScene = 1;\
  showScreen('chat-screen');\
  playScene(currentScene);\
\}\
\
function resetGame() \{\
  showScreen('opening');\
\}\
\
function scrollToBottom() \{\
  chatArea.scrollTop = chatArea.scrollHeight;\
\}\
\
function addHisMessage(text) \{\
  return new Promise(resolve => \{\
    const row = document.createElement('div');\
    row.className = 'message-row him';\
    row.innerHTML = '<div class="msg-icon">\uc0\u24444 </div><div class="bubble">' + escapeHtml(text) + '</div>';\
    chatArea.appendChild(row);\
    scrollToBottom();\
    resolve();\
  \});\
\}\
\
function addMyMessage(text) \{\
  const row = document.createElement('div');\
  row.className = 'message-row me';\
  row.innerHTML = '<div class="read-marker">\uc0\u26082 \u35501 </div><div class="bubble">' + escapeHtml(text) + '</div>';\
  chatArea.appendChild(row);\
  scrollToBottom();\
\}\
\
function showTyping() \{\
  const el = document.createElement('div');\
  el.className = 'typing-indicator';\
  el.id = 'typing';\
  el.innerHTML = '<div class="msg-icon">\uc0\u24444 </div><div class="typing-dots"><span>.</span><span>.</span><span>.</span></div>';\
  chatArea.appendChild(el);\
  scrollToBottom();\
\}\
\
function hideTyping() \{\
  const el = document.getElementById('typing');\
  if (el) el.remove();\
\}\
\
function escapeHtml(text) \{\
  const div = document.createElement('div');\
  div.textContent = text;\
  return div.innerHTML;\
\}\
\
function wait(ms) \{\
  return new Promise(r => setTimeout(r, ms));\
\}\
\
async function playScene(sceneNum) \{\
  isProcessing = true;\
  choicesArea.innerHTML = '';\
  const scene = scenes[sceneNum];\
\
  for (const msg of scene.messages) \{\
    showTyping();\
    await wait(msg.delay);\
    hideTyping();\
    await addHisMessage(msg.text);\
    await wait(300);\
  \}\
\
  // Show choices\
  isProcessing = false;\
  showChoices(scene.choices);\
\}\
\
function showChoices(choices) \{\
  choicesArea.innerHTML = '';\
  choices.forEach((choice, i) => \{\
    const btn = document.createElement('button');\
    btn.className = 'choice-btn';\
    btn.textContent = choice.text;\
    btn.onclick = () => selectChoice(choice);\
    choicesArea.appendChild(btn);\
  \});\
\}\
\
async function selectChoice(choice) \{\
  if (isProcessing) return;\
  isProcessing = true;\
  choicesArea.innerHTML = '';\
\
  // Show player message (unless silent)\
  if (!choice.silent) \{\
    addMyMessage(choice.text);\
    await wait(500);\
  \}\
\
  if (choice.result === 'next') \{\
    currentScene = choice.next;\
    await wait(800);\
    playScene(currentScene);\
  \} else if (choice.result === 'gameover') \{\
    await playGameOver(choice);\
  \} else if (choice.result === 'clear') \{\
    await playClear(choice);\
  \}\
\}\
\
async function playGameOver(choice) \{\
  if (choice.readIgnore) \{\
    const row = document.createElement('div');\
    row.className = 'message-row him';\
    row.innerHTML = '<div class="msg-icon">\uc0\u24444 </div><div class="bubble" style="color:#999;font-style:italic;">(\u26082 \u35501 \u28961 \u35222 )</div>';\
    chatArea.appendChild(row);\
    scrollToBottom();\
    await wait(2000);\
  \} else \{\
    for (const msg of choice.responses) \{\
      showTyping();\
      await wait(1500);\
      hideTyping();\
      await addHisMessage(msg);\
      await wait(300);\
    \}\
  \}\
\
  await wait(1000);\
\
  const msgsDiv = document.getElementById('gameover-messages');\
  msgsDiv.innerHTML = '';\
  if (choice.readIgnore) \{\
    msgsDiv.innerHTML = '<div class="gameover-msg" style="color:#999;font-style:italic;">(\uc0\u26082 \u35501 \u28961 \u35222 )</div>';\
  \} else \{\
    choice.responses.forEach(r => \{\
      const p = document.createElement('div');\
      p.className = 'gameover-msg';\
      p.textContent = '\uc0\u24444 : \u12300 ' + r + '\u12301 ';\
      msgsDiv.appendChild(p);\
    \});\
  \}\
\
  document.getElementById('gameover-blocked').textContent =\
    choice.blocked ? '-- \uc0\u12502 \u12525 \u12483 \u12463 \u12373 \u12428 \u12414 \u12375 \u12383  --' : '-- \u12466 \u12540 \u12512 \u12458 \u12540 \u12496 \u12540  --';\
  document.getElementById('gameover-reason').textContent = choice.reason;\
\
  showScreen('gameover-screen');\
\}\
\
async function playClear(choice) \{\
  for (const msg of choice.responses) \{\
    showTyping();\
    await wait(1500);\
    hideTyping();\
    await addHisMessage(msg);\
    await wait(300);\
  \}\
\
  await wait(1500);\
  showScreen('clear-screen');\
\}\
\
function shareOnX() \{\
  const text = "\uc0\u12417 \u12435 \u12393 \u12367 \u12373 \u12356 \u24444 \u12466 \u12540 \u12512 \u12434 \u12463 \u12522 \u12450 \u12375 \u12414 \u12375 \u12383 ! \u12463 \u12522 \u12450 \u29575 : 0.046% #\u12417 \u12435 \u12393 \u12367 \u12373 \u12356 \u24444 \u12466 \u12540 \u12512 ";\
  const url = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(text);\
  window.open(url, '_blank');\
\}\
